{
  "name": "super-bash",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --outfile=dist/client.js",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:socket.io",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "dev": "npm run build && npm run start",
    "simulate": "esbuild simulation.ts --bundle --platform=node --format=esm --outfile=dist/simulation.js && node dist/simulation.js"
  },
  "dependencies": {
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "esbuild": "^0.19.0",
    "@types/node": "^20.10.0"
  }
}

