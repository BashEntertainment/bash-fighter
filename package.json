{
  "name": "bash-fighter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/**/*.test.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "globals": "^15.9.0"
  }
}
